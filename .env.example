HOST=127.0.0.1
PORT=3000
# Clave privada de instalación: permite crear solo la primera cuenta; no inicia sesión.
ADMIN_TOKEN=
# Si se publica el panel: origen HTTPS exacto de un proxy propio. El túnel de WhatsApp no publica el panel.
PANEL_ORIGIN=
# Configurá todos estos valores para habilitar WhatsApp real.
# Usá un token de usuario del sistema; el token del asistente de prueba vence en unas 24 h.
# Instrucciones: docs/WHATSAPP-TOKEN.md. Nunca publiques la credencial.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Alias exactos de envío para destinatarios de prueba verificados; sin conversiones automáticas.
WHATSAPP_RECIPIENT_OVERRIDES={}
WHATSAPP_BUSINESS_ID=
META_APP_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
WEBHOOK_PUBLIC_URL=
GRAPH_VERSION=v25.0
# Plantilla aprobada con 3 parámetros: nombre, servicio, fecha y hora.
REMINDER_TEMPLATE=
REMINDER_LANGUAGE=es_AR
